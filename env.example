# Copy this file to `.env` (same folder as pom.xml) and fill in real values.
# `.env` is already covered by .gitignore's `*.env` pattern - never commit it.
# These are read as plain OS env vars (see application.yml) - if you use
# something like `direnv` or your IDE's run-config env file support, point
# it at your local `.env`. Plain `mvn spring-boot:run` will NOT read this
# file automatically unless your shell or IDE loads it into the environment.

# --- Database (native local PostgreSQL) ---
DB_NAME=ticketflow_db
DB_USER=ticketflow_user
DB_PASSWORD=ticketflow_pass

# --- JWT ---
# Generate your own - do not reuse this placeholder anywhere real.
# e.g. openssl rand -base64 48
JWT_SECRET=V4fuH63PIQTkyyT+BsNz6DWyjV/gsvbB4PPhfETUgc2e4oKiu8EIIY2B1pgO9cd0
JWT_EXPIRATION_MS=3600000

# --- AI provider ---
# mock (default, offline, no key needed) or openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Server ---
SERVER_PORT=8080
